{
  "name": "@ai-concept-compass/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "review": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:eval": "tsc --outDir dist --declaration false --sourceMap false",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:offline": "vitest run src/evals/offline-evals.test.ts",
    "eval:promptfoo": "npm run build:eval && PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval --no-cache --config promptfooconfig.yaml",
    "eval:matrix": "npm run build:eval && node scripts/preflight-live-eval.mjs && PROMPTFOO_LIVE=1 PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval --no-cache --config promptfoo.live.yaml"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.122",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "promptfoo": "0.120.19",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "posthog-node": "5.20.0",
    "protobufjs": "8.7.1",
    "hono": "4.13.7",
    "sharp": "0.35.4",
    "nanoid": "3.3.18",
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.8",
    "uuid": "11.1.1",
    "csv-parse": "7.0.2",
    "js-yaml@<4.3.2": "4.3.2",
    "ip-address": "10.7.1",
    "undici@7": "7.29.1",
    "undici@6": "6.28.1",
    "engine.io": "6.6.10",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "axios": "1.20.0",
    "compression": "1.8.2",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  },
  "packageManager": "npm@10.9.9"
}
